<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <!-- JRE Container cho JDK 22 -->
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-22">
        <attributes>
            <attribute name="module" value="true"/>
        </attributes>
    </classpathentry>

    <!-- Thư mục nguồn -->
    <classpathentry kind="src" path="src"/>

    <!-- Các JAR cũ trong thư mục jars -->
    <classpathentry kind="lib" path="jars/flatlaf-3.0.jar"/>
    <classpathentry kind="lib" path="jars/flatlaf-extras-3.1.jar"/>
    <classpathentry kind="lib" path="jars/flatlaf-fonts-roboto-2.137.jar"/>
    <classpathentry kind="lib" path="jars/flatlaf-swingx-3.5.4.jar"/>
    <classpathentry kind="lib" path="jars/flatlaf-theme-editor-3.5.4.jar"/>
    <classpathentry kind="lib" path="jars/jcalendar-1.4.jar"/>
    <classpathentry kind="lib" path="jars/commons-codec-1.11.jar"/>
    <classpathentry kind="lib" path="jars/commons-collections4-4.2.jar"/>
    <classpathentry kind="lib" path="jars/commons-compress-1.18.jar"/>
    <classpathentry kind="lib" path="jars/hamcrest-core-1.3.jar"/>
    <classpathentry kind="lib" path="jars/jcommon-1.0.23.jar"/>
    <classpathentry kind="lib" path="jars/jfreechart-1.0.19.jar"/>
    <classpathentry kind="lib" path="jars/jfreechart-1.0.19-experimental.jar"/>
    <classpathentry kind="lib" path="jars/jfreechart-1.0.19-swt.jar"/>
    <classpathentry kind="lib" path="jars/jfreesvg-2.0.jar"/>
    <classpathentry kind="lib" path="jars/junit-4.11.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre8.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre8-javadoc.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre8-sources.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre11.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre11-javadoc.jar"/>
    <classpathentry kind="lib" path="jars/mssql-jdbc-12.8.1.jre11-sources.jar"/>
    <classpathentry kind="lib" path="jars/mysql-connector-j-8.3.0.jar"/>
    <classpathentry kind="lib" path="jars/orsoncharts-1.4-eval-nofx.jar"/>
    <classpathentry kind="lib" path="jars/orsonpdf-1.6-eval.jar"/>
    <classpathentry kind="lib" path="jars/poi-4.0.1.jar"/>
    <classpathentry kind="lib" path="jars/poi-ooxml-4.0.1.jar"/>
    <classpathentry kind="lib" path="jars/poi-ooxml-schemas-4.0.1.jar"/>
    <classpathentry kind="lib" path="jars/servlet.jar"/>
    <classpathentry kind="lib" path="jars/svgSalamander-1.1.4.jar"/>
    <classpathentry kind="lib" path="jars/swingx-all-1.6.5-1.jar"/>
    <classpathentry kind="lib" path="jars/swtgraphics2d.jar"/>
    <classpathentry kind="lib" path="jars/xmlbeans-3.0.2.jar"/>
    <classpathentry kind="lib" path="jars/java-dotenv-5.2.2.jar"/>

    <!-- Thêm các JAR của JavaFX -->
    <classpathentry kind="lib" path="jars/javafx.base.jar"/>
    <classpathentry kind="lib" path="jars/javafx.controls.jar"/>
    <classpathentry kind="lib" path="jars/javafx.fxml.jar"/>
    <classpathentry kind="lib" path="jars/javafx.graphics.jar"/>
    <classpathentry kind="lib" path="jars/javafx.swing.jar"/>
    <classpathentry kind="lib" path="jars/javafx.media.jar"/> 
    <classpathentry kind="lib" path="jars/javafx.web.jar"/> 

    <!-- Thư mục đầu ra -->
    <classpathentry kind="output" path="bin"/>
</classpath>

